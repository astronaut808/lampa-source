LAMPA_IMAGE=ghcr.io/astronaut808/lampa-source
LAMPA_METRICS_IMAGE=ghcr.io/astronaut808/lampa-source-metrics
LAMPA_TAG=latest
LAMPA_BIND_ADDRESS=0.0.0.0
LAMPA_PORT=8090
IMAGE_TAG=local
BUILD_REVISION=local
LAMPA_CUB_TELEMETRY_ENABLED=false
LAMPA_BUILTIN_ADS_ENABLED=false
LAMPA_SHOTS_ENABLED=false
LAMPA_PLAYBACK_METRICS_ENABLED=true
LAMPA_CARD_METRICS_ENABLED=true
LAMPA_NETWORK_METRICS_ENABLED=true
LAMPA_PROGRESSIVE_CARD_ENABLED=true
LAMPA_FAST_STARTUP_ENABLED=true
SYNTHETIC_MONITORING_ENABLED=true
SYNTHETIC_INTERVAL_MS=60000
SYNTHETIC_TIMEOUT_MS=5000
SYNTHETIC_DNS_TARGETS=tmdb_images=image.tmdb.org,cub_api=apitmdb.cub.rip,cub=cub.rip
SYNTHETIC_HTTP_TARGETS=lampa=http://lampa:8080/healthz,cub=https://cub.rip/
